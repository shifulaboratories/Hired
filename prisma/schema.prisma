// Resume OS — data model
// Multi-tenant. Every record below belongs to exactly one User, and every read
// in src/lib/data/ takes a userId as its first argument so the compiler will
// not let a query go out unscoped.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ACCOUNTS
// ---------------------------------------------------------------------------

enum UserRole {
  /// The person who claimed the instance. Cannot be demoted or removed.
  SUPER_ADMIN
  /// Can invite people and manage users, but not touch the super admin.
  ADMIN
  /// Owns their own career history, resumes and pipeline. Sees nothing else.
  MEMBER
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String    @default("")
  /// scrypt, stored as "scrypt:N:r:p:salt:hash". Empty for someone who has
  /// only ever signed in with Google, so it is no longer on its own the test
  /// for whether an account is real — see isClaimed() in src/lib/auth.ts.
  passwordHash     String
  /// Google's stable subject id for this person, set the first time they sign
  /// in with Google. Nullable rather than "" so the database itself refuses to
  /// let two accounts claim one Google identity; a default of "" would collide
  /// across every password-only user.
  googleId         String?   @unique
  /// When this instance last had a REASON to believe this address belongs to
  /// this person: an admin addressed an invitation to it, they claimed the
  /// instance with it, or Google handed it over verified. Null means the
  /// account simply typed it into Settings, which proves nothing — and is why
  /// a Google sign-in will not silently adopt such an account. See
  /// resolveGoogleAccount in src/lib/google.ts.
  emailProvenAt    DateTime?
  role             UserRole  @default(MEMBER)
  isActive         Boolean   @default(true)
  /// Set when this person pays for the hosted instance through Stripe. Empty
  /// for the owner and anyone invited for free. When set, billing drives
  /// isActive: a lapsed subscription suspends, a recovered one reactivates.
  stripeCustomerId String    @default("")
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  invitedById String?
  invitedBy   User?   @relation("UserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees    User[]  @relation("UserInvites")

  sessions       Session[]
  mcpConnections McpConnection[]
  sentInvites    Invite[]        @relation("InviteSender")
  profile        Profile?
  roles          Role[]
  highlights     Highlight[]
  education      Education[]
  projects       Project[]
  skillGroups    SkillGroup[]
  certifications Certification[]
  notes          Note[]
  resumes        Resume[]
  companies      Company[]
  applications   Application[]
  contacts       Contact[]
  activities     Activity[]
  tasks          Task[]
  savedViews     SavedView[]
  tags           Tag[]
  pipelineShare  PipelineShare?
  linkedAccounts LinkedAccount[]

  @@index([role])
  @@index([stripeCustomerId])
}

/// A mailbox and calendar the app reads on a person's behalf: their Gmail,
/// their Microsoft 365, or any provider that speaks IMAP and CalDAV.
///
/// Separate from User.googleId on purpose: signing in proves who you are,
/// and this is permission to read your inbox — two different grants that a
/// person may give to two different accounts. A person may have several
/// (a work Outlook and a personal Gmail); every read merges across them.
///
/// Credentials are stored as issued — a refresh token for the OAuth
/// providers, an app password for IMAP — the way McpConnection stores its
/// token: the database is already the trust boundary here, and an instance
/// has no secret of its own to wrap them in without a second required
/// environment variable. Nothing read through them is ever copied into this
/// database; every screen and tool asks the provider live.
model LinkedAccount {
  id                   String          @id @default(cuid())
  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             AccountProvider
  /// The address of the mailbox, shown so a person can tell which one this is.
  email                String
  /// An optional name for the tile: "Work", "Old university address".
  label                String          @default("")
  /// What this account provides: "mail", "calendar". The OAuth consent
  /// screens let people untick one, and an IMAP account may have no CalDAV.
  features             String[]        @default([])
  /// The provider's own id for the account, when it has one.
  externalId           String          @default("")
  refreshToken         String          @default("")
  accessToken          String          @default("")
  accessTokenExpiresAt DateTime?
  /// IMAP and CalDAV, for the provider-less kind. App passwords, not the
  /// account password — every provider that supports this issues them.
  imapHost             String          @default("")
  imapPort             Int             @default(993)
  imapUsername         String          @default("")
  imapPassword         String          @default("")
  caldavUrl            String          @default("")
  caldavUsername       String          @default("")
  caldavPassword       String          @default("")
  /// Set when a read failed in a way that needs a person — a revoked token,
  /// a changed password. Cleared on reconnect.
  lastError            String          @default("")
  lastErrorAt          DateTime?
  lastUsedAt           DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([userId, provider, email])
  @@index([userId])
}

enum AccountProvider {
  GOOGLE
  MICROSOFT
  IMAP
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// One per AI client. Handing every client its own token means revoking the one
/// on a laptop you lost doesn't disconnect the others, and `lastUsedAt` answers
/// the only question anyone ever asks about a connector: is it actually working?
model McpConnection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// What the person called it, e.g. "Claude desktop".
  name   String
  /// Catalog id from src/lib/mcp/clients.ts — drives which setup card is shown.
  client String @default("other")
  token  String @unique

  lastUsedAt   DateTime?
  /// User-agent of whatever last called in, trimmed. Purely informational.
  lastUsedFrom String    @default("")
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model Invite {
  id               String    @id @default(cuid())
  email            String
  token            String    @unique
  role             UserRole  @default(MEMBER)
  invitedById      String
  invitedBy        User      @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt        DateTime
  acceptedAt       DateTime?
  /// Whether the invite email actually went out, so the UI can offer the raw link.
  emailSent        Boolean   @default(false)
  emailError       String    @default("")
  /// Set when this invite was created by a Stripe checkout, so the customer
  /// link survives the gap between paying and accepting: acceptInvite copies
  /// it onto the new User, and billing can suspend a lapsed subscription even
  /// if no webhook fires between those two moments.
  stripeCustomerId String    @default("")
  createdAt        DateTime  @default(now())

  @@index([email])
  @@index([acceptedAt])
}

/// A read-only link to someone's pipeline, for the friend or coach reviewing it.
///
/// The same privacy model as an unlisted resume, deliberately: an unguessable
/// slug and nothing else. No per-viewer accounts, no passwords, no expiry —
/// everyone you would send this to is somebody you already decided to send it
/// to, and permissions would be ceremony protecting nothing.
///
/// Revoking clears the slug rather than flipping a flag, so the address is
/// destroyed and re-sharing mints a different one. The reason you revoke is
/// usually that the link went somewhere you regret, and a pause you can undo
/// does not fix that.
///
/// One per person. A second link would need naming, listing and separate
/// revocation, which is a feature nobody has asked for yet.
model PipelineShare {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The public URL is /p/<slug>. Unique across the instance.
  slug          String    @unique
  /// Whether the closed applications appear. Off by default: the useful
  /// question for a reviewer is what is live, not what is over.
  includeClosed Boolean   @default(false)
  /// Answers "has anyone actually opened this". A timestamp rather than a
  /// counter, for the reason recorded against McpConnection: a throttled
  /// counter is a number that is quietly wrong.
  lastViewedAt  DateTime?
  createdAt     DateTime  @default(now())
}

/// Failed sign-in counters, so a public login form cannot be guessed at forever.
///
/// In the database rather than in memory because the app is stateless by
/// design: it restarts, and it may run as more than one replica. A counter held
/// in a process is a counter an attacker resets by waiting for a deploy.
///
/// One row per key, not one per attempt — a row per attempt is an unbounded
/// write amplifier pointed at your own database by anyone with curl.
model LoginThrottle {
  /// "email:someone@example.com" or "ip:1.2.3.4".
  key             String    @id
  failures        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  /// Set once the threshold is crossed. Null means not locked.
  lockedUntil     DateTime?
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([updatedAt])
}

/// What an admin did to whose account, and when.
///
/// Deliberately records the actor's and target's email as text rather than only
/// as a relation: the point of an audit row is to survive the deletion of the
/// account it describes. A log that empties itself when someone is removed
/// cannot answer the one question it exists for.
model AdminAudit {
  id          String   @id @default(cuid())
  actorId     String?
  actorEmail  String
  /// Verb, e.g. "user.suspend", "user.password_reset", "invite.create".
  action      String
  targetId    String?
  targetEmail String   @default("")
  /// Human-readable specifics. Never a password, a token or a secret.
  detail      String   @default("")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetId])
}

/// Instance-wide configuration: Resend credentials, instance name, signup policy.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum SystemEventLevel {
  /// It worked. Recorded because "it worked, at 14:02" is the only way to know
  /// a webhook is still arriving at all.
  INFO
  /// Suspicious but not broken — a signature that didn't verify, a send to an
  /// address Resend refused.
  WARN
  /// Something a person tried to do did not happen.
  ERROR
}

/// What the instance did, as opposed to what an admin did to an account.
///
/// AdminAudit answers "who suspended this user". This answers "is the thing
/// working" — did the Stripe webhook arrive, did the invite email actually
/// send, did a tool call blow up, did a page throw. Without it, a hosted
/// instance fails silently and the first you hear is a customer email.
///
/// Instance-level, admin-read-only, same as AdminAudit. Two rules keep it that
/// way, and both matter:
///
///   1. `userEmail` is text, never a relation, so a row still reads correctly
///      after the account is deleted.
///   2. **Never write an operation's inputs into this table.** An error message
///      produced by a failing operation is fine — "Missing required argument:
///      role_id", "Resend returned 422". The arguments that produced it are
///      not: they are someone's content, and every admin can read this. If you
///      are tempted to add `JSON.stringify(args)` to `detail`, don't.
model SystemEvent {
  id        String           @id @default(cuid())
  level     SystemEventLevel @default(ERROR)
  /// Where it came from: "stripe.webhook", "email.send", "mcp.tool", "app".
  source    String
  /// One line, safe to show every admin.
  message   String
  /// Specifics — a tool name, an event type, a status code. Never a secret.
  detail    String           @default("")
  /// Whose request hit it, when known.
  userEmail String           @default("")
  createdAt DateTime         @default(now())

  @@index([createdAt])
  @@index([source, createdAt])
  @@index([level, createdAt])
}

/// Someone who asked for access from the marketing site while the instance is
/// invite-only. Deliberately not a User and not an Invite: it is a request,
/// and it becomes an Invite only when an admin decides it should. Nothing here
/// grants access, so the public endpoint that writes it can stay open.
model WaitlistSignup {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String    @default("")
  /// What they're looking for, in their words. Optional, and never required —
  /// an email address alone is a complete signup.
  context     String    @default("")
  /// Which site the request came from. Set from the request's own Origin by
  /// the route, never from the body, so it can't be spoofed into a lie.
  source      String    @default("")
  /// Whether the owner's notification actually went out. Mirrors Invite: a
  /// signup that nobody was told about has to be visible as one, not silently
  /// swallowed because Resend was down.
  notified    Boolean   @default(false)
  notifyError String    @default("")
  /// Set when an admin turned this request into an Invite. Kept rather than
  /// deleted so the list stays a record of who asked and when.
  invitedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([invitedAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// ME — the knowledge base you dump everything into
// ---------------------------------------------------------------------------

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String   @default("")
  headline       String   @default("")
  email          String   @default("")
  phone          String   @default("")
  location       String   @default("")
  website        String   @default("")
  linkedin       String   @default("")
  github         String   @default("")
  twitter        String   @default("")
  /// Long-form "about me" background: values, working style, career narrative,
  /// what you want next, salary expectations, non-negotiables, etc.
  ///
  /// The column is still called brainDump — the concept was renamed to "me"
  /// and its raw text to "background", and @map keeps that rename off the
  /// database so no self-hosted instance needs a migration to follow along.
  summary        String   @default("")
  background     String   @default("") @map("brainDump")
  /// Which optional fields each pipeline view draws. Empty means "the default
  /// set for that view" rather than "nothing", so an account that has never
  /// touched this looks exactly as it did — and a field added to a catalogue
  /// later shows up for everybody instead of hiding behind a stored list that
  /// predates it. Scalar string lists, like Role.skills and Highlight.tags.
  boardFields    String[] @default([])
  listFields     String[] @default([])
  calendarFields String[] @default([])
  /// How wide each resizable column is, per list, as
  /// { "<list>": { "<column>": <pixels> } }. Json rather than the String[]
  /// above because this is a map with a number in it and a parallel array of
  /// "key:width" strings is the same thing with a parser bolted on.
  ///
  /// An absent list, or an absent column inside one, means that column's own
  /// default width — so a column added later is sized by the catalogue rather
  /// than by whatever was stored before it existed, and clearing a list is
  /// "back to the defaults" rather than "every column zero". Widths are
  /// clamped to each column's min and max on the way in AND on the way out:
  /// a stored 4000 predates a narrower max, and nothing that renders should
  /// trust a number a client sent months ago.
  columnWidths   Json     @default("{}")
  /// A square headshot, held as a data URI ("data:image/jpeg;base64,..."). It
  /// lives in the row rather than an object store so self-hosting still needs
  /// one environment variable, and so a published resume renders the picture
  /// with no second request to fetch it. The browser downscales before upload
  /// and the server refuses anything over PHOTO_MAX_BYTES.
  photo          String   @default("")
  /// When this person last finished — or skipped — the welcome tour. Null means
  /// they have never seen it, which is what makes the tour show itself once and
  /// then stay out of the way. Skipping sets it too: somebody who closed it does
  /// not want it again tomorrow, and "Show the tutorial again" in Settings is
  /// how it comes back.
  tourSeenAt     DateTime?
  /// Which calendar this person is on, as an IANA zone ("America/Los_Angeles").
  /// Every civil date in the product — today, overdue, the 9am nudge, the
  /// greeting — is computed from it, because a hosted instance runs on UTC and
  /// would otherwise turn a follow-up red at 5pm the day before it was due.
  ///
  /// Empty means the host's own clock, which is what every account had before
  /// this column existed and is exactly right for a self-hoster running it on
  /// the machine under their desk. The browser fills it in on first sight
  /// (src/components/onboarding/time-zone-seed.tsx) and Settings can override
  /// it. See src/lib/time.ts for the arithmetic.
  timeZone       String   @default("")
  updatedAt      DateTime @updatedAt
}

model Role {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        String
  title          String
  employmentType String   @default("Full-time")
  location       String   @default("")
  startDate      String   @default("")
  endDate        String   @default("")
  isCurrent      Boolean  @default(false)
  /// One or two sentences describing the scope of the role.
  summary        String   @default("")
  /// THE BACKGROUND. Unlimited markdown: projects, metrics, stories, tech,
  /// politics, wins, failures, praise, numbers. Claude mines this. Stored in
  /// the brainDump column — see the note on Profile.background.
  background     String   @default("") @map("brainDump")
  tags           String[] @default([])
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  highlights Highlight[]
  tasks      Task[]

  @@index([userId, sortOrder])
}

/// A reusable, polished achievement line distilled from a role's background.
model Highlight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String?
  role      Role?    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  text      String
  /// Optional quantified impact, e.g. "cut p95 latency 40%"
  impact    String   @default("")
  tags      String[] @default([])
  /// 1-5, how strong this bullet is. Used to auto-rank when tailoring.
  strength  Int      @default(3)
  archived  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([roleId])
}

model Education {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    String
  degree    String   @default("")
  field     String   @default("")
  location  String   @default("")
  startDate String   @default("")
  endDate   String   @default("")
  gpa       String   @default("")
  details   String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  role        String   @default("")
  url         String   @default("")
  description String   @default("")
  /// Stored in the brainDump column — see the note on Profile.background.
  background  String   @default("") @map("brainDump")
  tags        String[] @default([])
  startDate   String   @default("")
  endDate     String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model SkillGroup {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  skills    String[] @default([])
  sortOrder Int      @default(0)

  @@index([userId])
}

model Certification {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  issuer    String @default("")
  date      String @default("")
  url       String @default("")
  sortOrder Int    @default(0)

  @@index([userId])
}

/// Free-floating raw material not tied to a role: stories, STAR answers,
/// interview prep, references, compensation history, anything.
/// What a note is for. A GUARDRAIL is not filed away to be found later — it is
/// prepended to the briefing every connected client receives on connect, so it
/// is in context before the first tool call rather than only when a search
/// happens to hit its words.
enum NoteKind {
  NOTE
  GUARDRAIL
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @default("")
  kind      NoteKind @default(NOTE)
  tags      String[] @default([])
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]

  @@index([userId])
  @@index([userId, kind])
}

// ---------------------------------------------------------------------------
// RESUMES
// ---------------------------------------------------------------------------

/// Who can reach a resume by URL. There is no middle ground on purpose: an
/// unlisted resume is protected by an unguessable slug and nothing else, which
/// is the whole privacy model. Anything finer needs accounts for the viewer.
enum ResumeVisibility {
  /// No public URL. The default, and what unpublishing returns you to.
  PRIVATE
  /// Anyone with the link can read it. Not indexed, not listed anywhere.
  UNLISTED
}

model Resume {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetRole    String   @default("")
  targetCompany String   @default("")
  /// Template identity: "harvard" | "classic" | "modern" | "compact" | "editorial"
  template      String   @default("harvard")
  accent        String   @default("#000000")
  fontFamily    String   @default("serif")
  fontSize      Int      @default(10)
  lineHeight    Float    @default(1.2)
  /// 48px = the Harvard template's 0.5in page margin
  pageMargin    Int      @default(48)
  /// Show the owner's profile photo in this document's header. The picture
  /// itself is Profile.photo, never a copy — replace it once and every resume
  /// that shows it follows. Off by default, and templates whose convention
  /// forbids a photo ignore it.
  showPhoto     Boolean  @default(false)
  /// The full resume document (see src/lib/resume-schema.ts)
  data          Json
  notes         String   @default("")
  isFavorite    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// The public URL is /r/<slug>. Null until first published; cleared again on
  /// unpublish so a link that has been withdrawn can never come back to life.
  slug        String?          @unique
  visibility  ResumeVisibility @default(PRIVATE)
  publishedAt DateTime?

  /// The resume this was tailored from. Set by duplicate_resume (flattened to
  /// the root, so a copy of a variant still points at the base) and optionally
  /// by create_resume. SET NULL on delete: losing the base makes a variant
  /// standalone, it does not delete someone's tailored work.
  baseResumeId String?
  baseResume   Resume?  @relation("ResumeLineage", fields: [baseResumeId], references: [id], onDelete: SetNull)
  variants     Resume[] @relation("ResumeLineage")

  applications Application[]
  tasks        Task[]

  @@index([userId])
  @@index([baseResumeId])
}

// ---------------------------------------------------------------------------
// PIPELINE — the job-search CRM
// ---------------------------------------------------------------------------

enum Stage {
  WISHLIST
  APPLIED
  SCREEN
  INTERVIEW
  FINAL
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
  /// No reply, long enough that it is over. Distinct from REJECTED because
  /// nobody said no — the funnel counts it as a non-response, not a decision.
  GHOSTED
}

enum ActivityType {
  NOTE
  STAGE_CHANGE
  EMAIL_SENT
  EMAIL_RECEIVED
  CALL
  INTERVIEW
  FOLLOW_UP
  APPLIED
  OFFER
  REJECTION
  REFERRAL
  /// A message you sent first — a LinkedIn DM, a cold email to a hiring
  /// manager. Half of some searches happen here, before (or instead of) a
  /// formal application, and NOTE was hiding that from the record.
  OUTREACH
}

model Company {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  website    String    @default("")
  notes      String    @default("")
  /// Null means live. Set when somebody deletes this, which in this app means
  /// "put it in the archive" — the row leaves every list, picker and filter and
  /// waits out the retention window. A timestamp rather than a boolean because
  /// the countdown to being destroyed is measured from it.
  archivedAt DateTime?
  /// "" while live, the row's own id once archived. Company names are unique
  /// per person, and an archived "Stripe" must not stop you tracking a new job
  /// at Stripe. Prisma cannot express a partial unique index, so the
  /// discriminator is a column — the same workaround Tag.key uses.
  archiveKey String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  applications Application[]
  contacts     ContactCompany[]
  /// Industry, size, location and free tags, all as rows the person owns. They
  /// were three String columns, which meant one value each, no way to correct
  /// a typo everywhere at once, and no way to ask "who else is fintech".
  tags         CompanyTag[]
  tasks        Task[]

  @@unique([userId, name, archiveKey])
  @@index([userId])
  @@index([userId, updatedAt])
  @@index([userId, archivedAt])
}

model Application {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleTitle      String
  stage          Stage            @default(WISHLIST)
  jobUrl         String           @default("")
  jobDescription String           @default("")
  location       String           @default("")
  workMode       String           @default("")
  salaryRange    String           @default("")
  /// Where this one came from, and anything else worth labelling it with.
  /// Rows the person owns rather than free strings, so a label can be renamed,
  /// recoloured and — the point — deleted. The data layer flattens the join
  /// rows back to { id, name, color } before anything else sees them.
  tags           ApplicationTag[]
  notes          String           @default("")
  appliedAt      DateTime?
  nextFollowUpAt DateTime?
  closedAt       DateTime?
  /// Null means live. See Company.archivedAt. Its timeline and its tasks follow
  /// it in and out through this column rather than carrying their own, so a
  /// restore brings the whole thread back with no extra bookkeeping.
  archivedAt     DateTime?
  /// The id of the company whose archiving swept this application in. Null when
  /// it was archived on its own — which is the difference that stops restoring
  /// a company from dragging back an application you had already binned
  /// separately. No relation and no foreign key: the company can be destroyed
  /// first, and a dangling breadcrumb is harmless.
  archivedWith   String?
  resumeId       String?
  resume         Resume?          @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  activities Activity[]
  contacts   Contact[]
  tasks      Task[]

  @@index([userId, stage])
  @@index([userId, nextFollowUpAt])
  @@index([userId, archivedAt])
}

/// A channel an application came from, as something the person owns.
///
/// It was a free string in an array, which meant every spelling anyone ever
/// typed became a permanent option nobody could remove — and the starter list
/// was appended to everyone's picker forever by construction. A row can be
/// renamed, recoloured and deleted; deleting takes it off the applications
/// that carried it and leaves them otherwise untouched, because a label that
/// refuses to die is the bug this replaces.
/// What a tag labels. One table rather than six, because everything about a
/// tag — the name, the colour, renaming it everywhere, deleting it — is the
/// same code whatever it labels, and a person who learns the picker once has
/// learned all of them.
enum TagKind {
  /// Where an application came from. These were the old Source rows.
  APPLICATION
  COMPANY
  CONTACT
  /// The three that used to be String columns on Company.
  INDUSTRY
  SIZE
  LOCATION
}

model Tag {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   TagKind @default(APPLICATION)
  name   String
  /// lower(trim(name)). Case-insensitive uniqueness is the whole point —
  /// "LinkedIn" and "linkedin" are one channel — and Prisma cannot express a
  /// functional index, so the normalised form is a column.
  key    String
  /// A palette token name, not a hex: see --tag-* in globals.css. A stored hex
  /// is right in exactly one theme.
  color  String  @default("slate")

  applications ApplicationTag[]
  companies    CompanyTag[]
  contacts     ContactTag[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  /// Per kind, so "Remote" can be a location and a tag without colliding.
  @@unique([userId, kind, key])
  @@index([userId, kind, name])
}

/// The joins. Explicit rather than Prisma's implicit m2m because the migrations
/// have to write these rows in raw SQL, and an implicit table's name and its
/// "A"/"B" columns are a convention of Prisma's rather than a contract.
model ApplicationTag {
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([applicationId, tagId])
  @@index([tagId])
}

model CompanyTag {
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([companyId, tagId])
  @@index([tagId])
}

model ContactTag {
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([contactId, tagId])
  @@index([tagId])
}

model Contact {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  title          String           @default("")
  email          String           @default("")
  phone          String           @default("")
  relationship   String           @default("")
  /// Where to find them. Named columns for the platforms people actually ask
  /// for by name, so a tool can say "their LinkedIn" and mean one field —
  /// same shape as Profile, which settled this argument already.
  linkedin       String           @default("")
  twitter        String           @default("")
  instagram      String           @default("")
  github         String           @default("")
  website        String           @default("")
  /// Everything else someone is reachable at: Bluesky, Mastodon, a Substack,
  /// a personal page. A list rather than five more columns, because the tail
  /// of "other means of social media" has no end and none of it needs a name
  /// of its own to be openable.
  otherLinks     String[]         @default([])
  notes          String           @default("")
  /// When to next get in touch — the date that keeps a relationship warm.
  nextFollowUpAt DateTime?
  /// Everywhere they represent. A person is a founder at one company, an
  /// advisor at another and a friend who moved to a third, and pinning them to
  /// a single employer meant picking which of those to lose. The data layer
  /// flattens the join rows to { id, name, website } under the same name.
  companies      ContactCompany[]
  applicationId  String?
  application    Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  activities     Activity[]
  /// How this person is filed: "recruiter", "warm intro", "ex-colleague".
  tags           ContactTag[]
  /// Null means live. See Company.archivedAt. Their timeline follows them in
  /// and out through this one column rather than carrying its own.
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  tasks          Task[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([userId, archivedAt])
}

/// The join, explicit for the same reason ApplicationTag is: the migration
/// backfills these rows in raw SQL from the old Contact.companyId column, and
/// an implicit table's name and its "A"/"B" columns are Prisma's convention
/// rather than a contract. Cascades on both sides — deleting a company drops
/// the link, not the person, which is what the old SET NULL did too.
model ContactCompany {
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([contactId, companyId])
  @@index([companyId])
}

model Activity {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// An activity belongs to exactly one thing — an application or a contact.
  /// The data layer enforces the exactly-one rule; the schema can't.
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type          ActivityType @default(NOTE)
  body          String       @default("")
  /// Set on stage moves so the funnel can be reconstructed. Null on every other
  /// kind of activity, and on historic moves that were written with a note.
  fromStage     Stage?
  toStage       Stage?
  occurredAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())

  @@index([userId, occurredAt])
  @@index([applicationId, occurredAt])
  @@index([contactId, occurredAt])
  @@index([userId, toStage])
}

/// A named pipeline view: a cut of the board you keep coming back to.
///
/// Stores the query string rather than parsed fields — `view=list&f=SCREEN,INTERVIEW&sort=waiting`
/// — because the URL is already the state of that screen, and anything the
/// toolbar learns to encode later is saved without a migration. The tradeoff
/// is that nothing validates the query: a view saved against a stage that is
/// later removed just returns everything, which is the harmless failure.
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// Query string without the leading "?". Empty means the default board.
  query     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, name])
  @@index([userId, name])
}

/// A task is about at most one thing, and the thing can be almost anything.
///
/// Five nullable foreign keys rather than a `subjectKind` + `subjectId` pair,
/// because the pair has no referential integrity: delete a resume and the task
/// keeps pointing at an id nothing can resolve, forever, with nothing in the
/// database to stop it. These cascade, so a subject going takes its tasks with
/// it — which is what `applicationId` already did and what people expect.
///
/// At most one is set. Nothing in Postgres enforces that; `taskSubject` in
/// src/lib/data/pipeline.ts does, on the way in, and the reader takes the first
/// one it finds so a hand-written row can never render two subjects.
model Task {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  detail        String       @default("")
  dueAt         DateTime?
  done          Boolean      @default(false)
  doneAt        DateTime?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  resumeId      String?
  resume        Resume?      @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  roleId        String?
  role          Role?        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  noteId        String?
  note          Note?        @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([userId, done, dueAt])
  @@index([companyId])
  @@index([contactId])
  @@index([resumeId])
  @@index([roleId])
  @@index([noteId])
}
