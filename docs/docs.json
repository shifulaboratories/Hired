{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Hired",
  "description": "Hired is a career operating system you host yourself: a record of everything you have done, a resume builder that assembles documents from it, and a pipeline for the search \u2014 all of it reachable from the assistant you already talk to.",
  "colors": {
    "primary": "#0c71d1",
    "light": "#2e91f2",
    "dark": "#0a58a4"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://hired.tools"
  },
  "appearance": {
    "default": "system"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/shifulaboratories/Hired"
      },
      {
        "label": "hired.tools",
        "href": "https://hired.tools"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://app.hired.tools/login"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/shifulaboratories/Hired",
      "linkedin": "https://www.linkedin.com/company/shifulab/",
      "x": "https://x.com/shifulab"
    },
    "links": [
      {
        "header": "Hired",
        "items": [
          {
            "label": "The product",
            "href": "https://hired.tools"
          },
          {
            "label": "Sign in",
            "href": "https://app.hired.tools/login"
          },
          {
            "label": "Resources",
            "href": "https://hired.tools/resources/"
          }
        ]
      },
      {
        "header": "Source",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/shifulaboratories/Hired"
          },
          {
            "label": "AGPL-3.0",
            "href": "https://github.com/shifulaboratories/Hired/blob/main/LICENSE"
          },
          {
            "label": "Shifu Labs",
            "href": "https://shifulab.com"
          }
        ]
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guide",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "index",
              "quickstart",
              "connect",
              "skills"
            ]
          },
          {
            "group": "The four areas",
            "pages": [
              "concepts/how-it-fits",
              "concepts/me",
              "concepts/resumes",
              "concepts/pipeline",
              "concepts/crm"
            ]
          },
          {
            "group": "Doing the work",
            "pages": [
              "guides/fill-in-me",
              "guides/tailor-a-resume",
              "guides/publish-and-export",
              "guides/run-the-search",
              "guides/research-and-prep",
              "guides/weekly-review",
              "guides/inbox-and-calendar",
              "guides/what-to-say"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "workflows",
              "app",
              "reference/security",
              "reference/troubleshooting",
              "reference/faq"
            ]
          }
        ]
      },
      {
        "tab": "Tools",
        "groups": [
          {
            "group": "Tools",
            "pages": [
              "tools/overview",
              "tools/me",
              "tools/resumes",
              "tools/letters",
              "tools/pipeline",
              "tools/crm",
              "tools/archive",
              "tools/accounts",
              "tools/connections",
              "tools/admin"
            ]
          }
        ]
      },
      {
        "tab": "Self-hosting",
        "groups": [
          {
            "group": "Deploy it",
            "pages": [
              "self-hosting/overview",
              "self-hosting/docker",
              "self-hosting/railway",
              "self-hosting/local"
            ]
          },
          {
            "group": "Configure it",
            "pages": [
